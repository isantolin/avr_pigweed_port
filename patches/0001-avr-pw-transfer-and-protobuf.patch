+    // The copied Event initially points into the ring slot. Rebind payload
+    // pointers to the detached local slot before the ring slot is reused.
+    if (current.event.type == EventType::kClientChunk ||
+        current.event.type == EventType::kServerChunk) {
+      current.event.chunk.data = current.chunk_storage.data();
+    } else if (current.event.type == EventType::kNewClientTransfer ||
+               current.event.type == EventType::kNewServerTransfer) {
+      current.event.new_transfer.raw_chunk_data = current.chunk_storage.data();
+    }
+    HandleEvent(current.event);
+    ++processed;
+  }
+  (void)HandleTimeouts();
+  UpdateCooperativeRole();
+  return event_queue_size_ != 0 ? Status::Unavailable() : OkStatus();
+}
+
+void TransferThread::UpdateCooperativeRole() {
+  if (cooperative_start_pending_) {
+    return;
+  }
+  for (const Context& context : client_transfers_) {
+    if (context.active()) return;
+  }
+  for (const Context& context : server_transfers_) {
+    if (context.active()) return;
+  }
+  cooperative_role_ = CooperativeRole::kIdle;
+  cooperative_session_id_ = 0;
+}
+#endif  // PW_TRANSFER_COOPERATIVE
+
+bool TransferThread::HandleTimeouts() {
+  bool did_work = false;
+  for (Context& context : client_transfers_) {
+    if (context.timed_out()) {
+      context.HandleEvent({.type = EventType::kClientTimeout});
+      did_work = true;
+    }
+  }
+  for (Context& context : server_transfers_) {
+    if (context.timed_out()) {
+      context.HandleEvent({.type = EventType::kServerTimeout});
+      did_work = true;
+    }
+  }
+  return did_work;
+}
 
