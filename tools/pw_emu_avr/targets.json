{
  "targets": {
    "atmega328p": {
      "gdb": [
        "avr-gdb",
        "-ex",
        "set remote memory-map-packet off"
      ],
      "simavr": {
        "mcu": "atmega328p",
        "frequency": 16000000,
        "channels": {
          "uarts": {
            "uart0": {
              "id": "0"
            }
          }
        }
      }
    },
    "atmega2560": {
